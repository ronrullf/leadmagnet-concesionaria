---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { timeAgo } from '../../../lib/format';
import { siteBase } from '../../../lib/site';

let products: any[] = [];
let visits: any[] = [];
let dbError: string | null = null;

try {
  const db = supabaseAdmin();
  const [{ data: p }, { data: v }] = await Promise.all([
    db.from('product_demos').select('id, slug, product_name, business_name, niche_key, mood, is_active, created_at').order('created_at', { ascending: false }),
    db.from('product_demo_visits').select('product_demo_id, visited_at').eq('is_owner_view', false),
  ]);
  products = p ?? [];
  visits = v ?? [];
} catch (e) {
  dbError = e instanceof Error ? e.message : 'Error de conexión';
}

const siteUrl = siteBase(Astro.url.origin);

const stats = new Map<string, { count: number; last: string | null }>();
for (const v of visits) {
  const s = stats.get(v.product_demo_id) ?? { count: 0, last: null };
  s.count++;
  if (!s.last || v.visited_at > s.last) s.last = v.visited_at;
  stats.set(v.product_demo_id, s);
}

const rows = products
  .map((d) => {
    const s = stats.get(d.id) ?? { count: 0, last: null };
    const link = `${siteUrl}/producto/${d.slug}`;
    const outreach = `Hola! Estaba viendo los productos de ${d.business_name} y les preparé este demo interactivo exclusivo para ${d.product_name}: ${link}`;
    return { ...d, visitCount: s.count, lastVisit: s.last, link, outreach };
  })
  .sort((a, b) => (b.lastVisit ?? '').localeCompare(a.lastVisit ?? ''));

const dateFmt = new Intl.DateTimeFormat('es-VE', { day: '2-digit', month: 'short' });
---

<AdminLayout title="Productos & Servicios">
  {/* Navegación de Pestañas Admin */}
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4">
    <div class="flex flex-wrap items-center gap-2">
      <a href="/admin" class="rounded-[6px] border border-line px-3 py-1.5 text-xs font-semibold text-ink-soft hover:bg-paper-alt">
        🏠 Inmobiliarias & Autos
      </a>
      <a href="/admin/pro" class="rounded-[6px] border border-line px-3 py-1.5 text-xs font-semibold text-ink-soft hover:bg-paper-alt">
        🩺 Profesionales
      </a>
      <a href="/admin/producto" class="rounded-[6px] bg-ink px-3 py-1.5 text-xs font-semibold text-white">
        ⚡ Productos & Servicios
      </a>
    </div>
    <a href="/admin/producto/generar" class="rounded-[4px] bg-[#F97316] px-4 py-2 text-sm font-semibold text-white hover:bg-[#EA580C]">
      + Generar Producto con IA
    </a>
  </div>

  <div class="mb-4">
    <h1 class="text-[1.5625rem] font-bold">Landings de Productos y Servicios</h1>
    <p class="text-xs text-ink-soft">Generadores, plantas eléctricas, inversores, paneles solares, repuestos marinos y equipos de alto valor.</p>
  </div>

  {dbError && (
    <div class="mb-6 rounded-[8px] border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
      <p class="font-semibold">Supabase no está configurado o falta la migración 009.</p>
      <p class="mt-1">Ejecuta <code class="num">009_product_demos.sql</code> en el SQL Editor de Supabase. Detalle: {dbError}</p>
    </div>
  )}

  {rows.length === 0 && !dbError ? (
    <div class="rounded-[8px] border border-line bg-paper p-10 text-center text-ink-soft">
      <p>No hay landings de productos registradas todavía.</p>
      <a href="/admin/producto/generar" class="mt-3 inline-block rounded-[4px] bg-[#F97316] px-4 py-2 text-sm font-semibold text-white">Generar la primera</a>
    </div>
  ) : (
    <div class="overflow-x-auto rounded-[8px] border border-line bg-paper">
      <table class="w-full min-w-[760px] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-[0.75rem] uppercase tracking-wide text-ink-soft">
            <th class="px-4 py-3">Producto / Empresa</th>
            <th class="px-4 py-3">Nicho</th>
            <th class="px-4 py-3">Slug</th>
            <th class="px-4 py-3">Creado</th>
            <th class="px-4 py-3">Visitas</th>
            <th class="px-4 py-3">Última visita</th>
            <th class="px-4 py-3">Estado</th>
            <th class="px-4 py-3">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((d) => (
            <tr class="border-b border-line last:border-0">
              <td class="px-4 py-3 font-medium">
                {d.product_name}
                <span class="block text-[0.75rem] font-normal text-ink-soft">{d.business_name}</span>
              </td>
              <td class="px-4 py-3">
                <span class="num rounded-[4px] bg-paper-alt px-2 py-0.5 text-[0.7rem] uppercase font-semibold text-ink-soft">
                  {d.niche_key}
                </span>
              </td>
              <td class="num px-4 py-3 text-ink-soft">{d.slug}</td>
              <td class="num px-4 py-3 text-ink-soft">{dateFmt.format(new Date(d.created_at))}</td>
              <td class="num px-4 py-3 font-semibold">{d.visitCount}</td>
              <td class="num px-4 py-3">
                {d.lastVisit ? (
                  <span class={Date.now() - new Date(d.lastVisit).getTime() < 24 * 3600 * 1000 ? 'font-semibold text-green-700' : 'text-ink-soft'}>{timeAgo(d.lastVisit)}</span>
                ) : (<span class="text-ink-soft">—</span>)}
              </td>
              <td class="px-4 py-3">
                <button type="button" data-toggle data-id={d.id} data-active={String(d.is_active)}
                  class={`rounded-[4px] px-2 py-1 text-[0.75rem] font-semibold ${d.is_active ? 'bg-green-100 text-green-800' : 'bg-paper-alt text-ink-soft'}`}>
                  {d.is_active ? 'Activo' : 'Inactivo'}
                </button>
              </td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={`${d.link}?v=0`} target="_blank" rel="noopener" class="text-[0.75rem] font-medium underline">Ver</a>
                  <a href={`/admin/producto/${d.slug}/editar`} class="text-[0.75rem] font-medium underline">Editar</a>
                  <button type="button" data-copy={d.link} class="rounded-[4px] border border-line px-2 py-1 text-[0.75rem] font-medium">Copiar link</button>
                  <button type="button" data-copy={d.outreach} class="rounded-[4px] bg-green-700 px-2 py-1 text-[0.75rem] font-semibold text-white">Copiar mensaje</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <script>
    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const copyBtn = target.closest('[data-copy]') as HTMLElement | null;
      if (copyBtn) {
        await navigator.clipboard.writeText(copyBtn.dataset.copy || '');
        const o = copyBtn.textContent; copyBtn.textContent = '✓ Copiado';
        setTimeout(() => (copyBtn.textContent = o), 1500);
        return;
      }
      const toggleBtn = target.closest('[data-toggle]') as HTMLElement | null;
      if (toggleBtn) {
        const next = toggleBtn.dataset.active !== 'true';
        const res = await fetch('/api/product/toggle', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: toggleBtn.dataset.id, is_active: next }),
        });
        if (res.ok) location.reload();
      }
    });
  </script>
</AdminLayout>
