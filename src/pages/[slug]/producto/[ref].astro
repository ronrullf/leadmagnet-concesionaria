---
import DemoLayout from '../../../layouts/DemoLayout.astro';
import PriceBcv from '../../../components/PriceBcv.astro';
import OrderBlock from '../../../components/OrderBlock.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { getDemoBySlug, getProducts } from '../../../lib/demos';
import { getBcvRate } from '../../../lib/bcv';
import { notFoundResponse } from '../../../lib/not-found';

const { slug, ref } = Astro.params;
const demo = await getDemoBySlug(slug!);
if (!demo || demo.vertical !== 'tienda') return notFoundResponse();

const [products, bcv] = await Promise.all([getProducts(demo.id), getBcvRate()]);

const product = products.find((p) => p.ref_code === ref);
if (!product) return notFoundResponse();

const others = products.filter((p) => p.ref_code !== ref).slice(0, 4);
const onSale = product.compare_at_usd != null && product.compare_at_usd > product.price_usd;
---

<DemoLayout
  demo={demo}
  title={`${product.title} — ${demo.agency_name}`}
  description={`${product.title}. Disponible en ${demo.agency_city}.`}
  path={`/producto/${product.ref_code}`}
>
  <article class="mx-auto max-w-[1200px] px-4 py-6 sm:px-6 sm:py-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-12">
      {/* Galería */}
      <div id="gallery" class="flex flex-col gap-3">
        <button
          id="gallery-main"
          type="button"
          class="block aspect-square w-full cursor-zoom-in overflow-hidden rounded-[8px] border border-line"
          aria-label="Ampliar imagen"
        >
          <img src={product.image_urls[0]} alt={product.title} class="h-full w-full object-cover" fetchpriority="high" />
        </button>

        {product.image_urls.length > 1 && (
          <div class="flex gap-2 overflow-x-auto pb-1">
            {product.image_urls.map((url, i) => (
              <button
                type="button"
                data-thumb={url}
                class={`h-20 w-20 shrink-0 overflow-hidden rounded-[6px] border border-line ring-accent ${i === 0 ? 'ring-2' : ''}`}
                aria-label={`Imagen ${i + 1}`}
              >
                <img src={url} alt="" loading="lazy" class="h-full w-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      {/* Lightbox */}
      <div
        id="lightbox"
        class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink/95 p-4"
        role="dialog"
        aria-modal="true"
        aria-label="Galería de imágenes"
      >
        <img src={product.image_urls[0]} alt={product.title} class="max-h-[85vh] max-w-full rounded-[4px] object-contain" />
        <button data-lb-close type="button" class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white" aria-label="Cerrar">✕</button>
        <button data-lb-prev type="button" class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white" aria-label="Anterior">‹</button>
        <button data-lb-next type="button" class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white" aria-label="Siguiente">›</button>
      </div>

      {/* Información y pedido */}
      <aside class="flex flex-col gap-5 lg:sticky lg:top-24 lg:h-fit">
        <header class="flex flex-col gap-2">
          <div class="num flex flex-wrap items-center gap-2 text-[0.7rem] uppercase tracking-[0.12em] text-ink-soft">
            {product.category && <span class="rounded-[4px] bg-paper-alt px-2 py-1">{product.category}</span>}
            <span>{product.ref_code}</span>
          </div>
          <h1 class="display-tight font-display text-[1.5625rem] font-bold leading-tight sm:text-[1.9375rem]">
            {product.title}
          </h1>
        </header>

        <div class="flex flex-col gap-1 border-y border-line py-4">
          {onSale && (
            <span class="num text-[0.95rem] text-ink-soft line-through">
              ${new Intl.NumberFormat('es-VE').format(product.compare_at_usd as number)}
            </span>
          )}
          <PriceBcv priceUsd={product.price_usd} bcv={bcv} size="lg" />
        </div>

        <OrderBlock demo={demo} product={product} />

        {product.description && (
          <div>
            <h2 class="mb-2 font-display text-[1.125rem] font-semibold">Descripción</h2>
            <p class="leading-relaxed text-ink-soft">{product.description}</p>
          </div>
        )}
      </aside>
    </div>

    {/* Otros productos */}
    {others.length > 0 && (
      <section class="mt-14 border-t border-line pt-8 sm:mt-16 sm:pt-10">
        <h2 class="display-tight mb-6 font-display text-[1.25rem] font-bold sm:text-[1.5625rem]">También te puede gustar</h2>
        <div class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
          {others.map((p, i) => (
            <ProductCard product={p} slug={demo.slug} bcv={bcv} stagger={(i % 2) * 40} />
          ))}
        </div>
      </section>
    )}
  </article>
</DemoLayout>
