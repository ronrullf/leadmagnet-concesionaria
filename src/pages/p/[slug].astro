---
/**
 * Landing-demo de outreach. Única página pública del módulo.
 *
 * Quien la abre es el PROSPECTO, no un paciente. Todo el contenido le habla a
 * sus pacientes y todos los CTA van a SU WhatsApp; la única pieza dirigida a él
 * es la barra de autoría del layout.
 */
import OutreachLayout from '../../layouts/OutreachLayout.astro';
import OutreachLanding from '../../components/outreach/OutreachLanding.astro';
import { getProBySlug } from '../../lib/pro';
import { isExpired } from '../../lib/outreach-schema';
import { notFoundResponse } from '../../lib/not-found';
import { isAuthed } from '../../lib/auth';

const { slug } = Astro.params;

// Un admin autenticado puede previsualizar borradores y links vencidos; el
// prospecto no. Así el editor funciona antes de activar y después de expirar.
const admin = isAuthed(Astro);
const pro = slug ? await getProBySlug(slug, admin) : null;
if (!pro) return notFoundResponse();

// Vida del link (§7.3): al octavo día deja de existir para el prospecto.
if (!admin && isExpired(pro.expira)) {
  return Astro.redirect('/expirado', 302);
}

const isDraft = admin && !pro.is_active;
const vencido = admin && isExpired(pro.expira);
---

<OutreachLayout pro={pro} path="/">
  {(isDraft || vencido) && (
    <div class="aviso">
      {isDraft && 'Borrador · solo visible para ti. Actívalo en el panel.'}
      {isDraft && vencido && ' · '}
      {vencido && 'Link vencido · el prospecto ya vería la página de expirado.'}
    </div>
  )}

  <OutreachLanding pro={pro} />
</OutreachLayout>

<style>
  .aviso {
    position: sticky; top: 0; z-index: 60;
    padding: 8px 16px;
    background: #fef3c7; color: #92400e;
    border-bottom: 1px solid #fcd34d;
    font-size: 13px; font-weight: 600; text-align: center;
  }
</style>
