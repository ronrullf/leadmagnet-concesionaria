---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover para respetar el notch; sin maximum-scale para no
        bloquear el zoom manual (accesibilidad). El zoom automático de iOS se
        evita con font-size 16px en los campos, no capando el gesto. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — Admin TiendaPana</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F97316" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <style is:global>
      /* ============================================================
         Reglas móviles del panel. Viven aquí para que apliquen a las
         cuatro pantallas de creación (demos, concesionarios y landings)
         sin repetir clases en cada formulario.
         ============================================================ */
      @media (max-width: 768px) {
        /* iOS hace zoom al enfocar cualquier campo por debajo de 16px, y
           deja la página descuadrada. 16px es el mínimo que lo evita. */
        input:not([type='checkbox']):not([type='radio']),
        select,
        textarea {
          font-size: 16px !important;
        }

        /* Objetivos táctiles: 44px es el mínimo usable con el pulgar. */
        button,
        select,
        input:not([type='checkbox']):not([type='radio']):not([type='hidden']),
        a.btn-like {
          min-height: 44px;
        }
        input[type='checkbox'],
        input[type='radio'] {
          width: 20px;
          height: 20px;
        }
        /* El área táctil real de un checkbox es su etiqueta, no la caja. */
        label:has(> input[type='checkbox']),
        label:has(> input[type='radio']) {
          min-height: 44px;
          align-items: center;
        }

        /* Ningún formulario del panel debe desbordar a lo ancho. */
        main {
          overflow-x: hidden;
        }

        /* Las rejillas de dos y tres columnas colapsan a una sola. */
        .adm-stack {
          grid-template-columns: 1fr !important;
        }
      }

      /* El área táctil de los checkbox/radio dentro de etiquetas */
      label:has(> input[type='checkbox']),
      label:has(> input[type='radio']) {
        cursor: pointer;
      }
    </style>
  </head>
  <body class="min-h-screen bg-paper-alt text-ink">
    <header class="sticky top-0 z-40 border-b border-line bg-paper">
      <div class="mx-auto flex max-w-[1100px] flex-wrap items-center justify-between gap-2 px-4 py-2.5 sm:h-14 sm:flex-nowrap sm:gap-3 sm:px-6 sm:py-0">
        <a href="/admin" class="flex min-w-0 items-center gap-2 font-semibold">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-[8px] bg-[#F97316] text-sm font-bold text-white">T</span>
          <span class="truncate">Demos · TiendaPana</span>
        </a>
        <div class="flex shrink-0 items-center gap-2 sm:gap-3">
          <a
            href="/admin/nuevo"
            class="flex items-center rounded-[6px] bg-[#F97316] px-3 py-2.5 text-sm font-semibold text-white hover:bg-[#EA580C] sm:px-4 sm:py-2"
          ><span class="sm:hidden">+ Nuevo</span><span class="hidden sm:inline">+ Nuevo demo</span></a>
          <button
            id="logout-btn"
            type="button"
            class="rounded-[6px] border border-line px-3 py-2.5 text-sm font-medium text-ink-soft hover:text-ink sm:py-2"
          >Salir</button>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-[1100px] px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </main>
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/';
      });
    </script>
  </body>
</html>
