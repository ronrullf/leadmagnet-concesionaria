---
/**
 * El formato de landing de profesional. Uno solo, para todos los rubros.
 *
 * Proporción 50 / 40 / 10:
 *   50% visual → foto del hero, dos pares antes/después, foto de historia.
 *   40% copy   → lo que escribe la IA: calificación, historia, qué incluye,
 *                testimonio y preguntas. Es lo que convierte cuando la imagen
 *                ya enganchó.
 *   10% CTA    → el par de botones (acento + WhatsApp) repetido, más el
 *                flotante que nunca desaparece.
 *
 * Toda sección con su ranura vacía se omite entera: nunca un hueco ni un
 * margen fantasma. El profesional aporta las fotos; la IA aporta el copy.
 */
import CtaPair from './CtaPair.astro';
import ServiceIcon from './ServiceIcon.astro';
import { waLink, proCtaMessage } from '../../lib/whatsapp';
import type { ProDemo } from '../../lib/pro-types';

interface Props {
  pro: ProDemo;
}

const { pro } = Astro.props;
const c = pro.copy;

const ctaLabel = c.hero.cta_label || 'Agendar cita';
const closingLabel = c.closing.cta_label || 'Agenda tu evaluación';
const ctaHref = waLink(pro.whatsapp_e164, proCtaMessage(pro.pro_name, ctaLabel));

/** Dos pares bastan: el tercero ya no suma prueba, solo alarga la página. */
const cases = (pro.before_after ?? []).slice(0, 2);
const services = (pro.services ?? []).slice(0, 4);
const testimonial = c.proof.testimonials[0];
/** El copy se acota a propósito: pasado este punto cada bloque resta. */
const offerItems = c.offer.items.slice(0, 3);
const faqs = c.faqs.slice(0, 3);

const showCases = cases.length > 0;
const showQualify = c.qualify.yes.length > 0 || c.qualify.no.length > 0;
const showStory = Boolean(c.story.wall && c.story.epiphany);
const showOffer = offerItems.length > 0;
const showTrust = Boolean(pro.trust_line);
const showServices = services.length > 0;
const showTestimonial = Boolean(testimonial?.quote);
const showMetrics = c.proof.metrics.length > 0;
const showFaqs = faqs.length > 0;
const showLocation = Boolean(pro.address || pro.maps_query);
const mapsQuery = pro.maps_query || pro.address || '';
---

{/* Hero · foto + una frase + el par de botones */}
<section class="phero" data-section="hero">
  {pro.photo_hero_url ? (
    <img class="phero__bg" src={pro.photo_hero_url} alt="" fetchpriority="high" />
  ) : (
    <div class="phero__bg phero__bg--empty"></div>
  )}
  <div class="phero__veil"></div>

  <div class="phero__inner">
    {pro.logo_url && (
      <img class="phero__logo" src={pro.logo_url} alt={pro.pro_name} height="44" loading="eager" />
    )}
    <h1 class="phero__name">{pro.pro_name}</h1>
    <p class="phero__line">{pro.pro_title}</p>
    {c.hero.headline && <p class="phero__headline">{c.hero.headline}</p>}
    {c.hero.subheadline && <p class="phero__sub">{c.hero.subheadline}</p>}
    <div class="phero__cta">
      <CtaPair href={ctaHref} label={ctaLabel} size="lg" />
    </div>
  </div>
</section>

{/* Calificación · para quién sí y para quién no */}
{showQualify && (
  <section class="pqual" data-section="qualify">
    <div class="wrapx pqual__grid">
      {c.qualify.yes.length > 0 && (
        <div class="reveal">
          <p class="eyebrow">Esto es para usted si…</p>
          <ul class="pqual__col pqual__col--yes" role="list">
            {c.qualify.yes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}
      {c.qualify.no.length > 0 && (
        <div class="reveal">
          <p class="eyebrow">Esto no es para usted si…</p>
          <ul class="pqual__col pqual__col--no" role="list">
            {c.qualify.no.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

{/* Antes / después · la prueba. Dos casos, sin texto encima. */}
{showCases && (
  <section class="pcases" data-section="cases">
    <div class="wrapx">
      <p class="eyebrow eyebrow--center reveal">Resultados reales</p>
      <div class="pcases__grid">
        {cases.map((cs, i) => (
          <article class="pcase reveal" data-case>
            <div class="pcase__pair">
              <figure class="pcase__side">
                <img src={cs.before} alt="Antes" loading={i === 0 ? 'eager' : 'lazy'} />
                <figcaption class="pcase__tag">Antes</figcaption>
              </figure>
              <figure class="pcase__side">
                <img src={cs.after} alt="Después" loading={i === 0 ? 'eager' : 'lazy'} />
                <figcaption class="pcase__tag pcase__tag--after">Después</figcaption>
              </figure>
            </div>
            {cs.label && <p class="pcase__label">{cs.label}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{/* Banda de acción · justo después de que la prueba pegó */}
{showCases && (
  <section class="pband" data-section="cta-band">
    <div class="pband__inner reveal">
      <p class="pband__text">¿Quiere un resultado así?</p>
      <CtaPair href={ctaHref} label={ctaLabel} size="lg" />
    </div>
  </section>
)}

{/* Línea de confianza */}
{showTrust && (
  <section class="ptrust" data-section="trust">
    <p class="ptrust__line reveal">{pro.trust_line}</p>
  </section>
)}

{/* Historia · el puente de la epifanía */}
{showStory && (
  <section class="pstory" data-section="story">
    <div class="wrapx pstory__grid">
      {pro.photo_story_url && (
        <div class="pstory__photo reveal">
          <img src={pro.photo_story_url} alt={pro.pro_name} loading="lazy" />
        </div>
      )}
      {/* El muro, el giro y el resultado. Sin el "dónde estaba" ni el "plan":
          eso es el "sobre nosotros" largo que nadie lee antes de ver la prueba. */}
      <div class="pstory__text reveal">
        <p class="pstory__wall">{c.story.wall}</p>
        <p>{c.story.epiphany}</p>
        {c.story.result && <p class="pstory__result">{c.story.result}</p>}
      </div>
    </div>
  </section>
)}

{/* Servicios · iconos, no ensayo */}
{showServices && (
  <section class="pservices" data-section="services">
    <ul class="pservices__grid reveal" role="list">
      {services.map((s) => (
        <li class="pservice">
          <ServiceIcon name={s.icon} />
          <span class="pservice__label">{s.label}</span>
        </li>
      ))}
    </ul>
  </section>
)}

{/* Qué incluye · sin precios, se cotiza en el chat */}
{showOffer && (
  <section class="poffer" data-section="offer">
    <div class="wrapx">
      {c.offer.program_name && <h2 class="poffer__title reveal">{c.offer.program_name}</h2>}
      <ul class="poffer__list" role="list">
        {offerItems.map((item) => (
          <li class="poffer__item reveal">
            <p class="poffer__item-title">{item.title}</p>
            {item.description && <p class="poffer__item-desc">{item.description}</p>}
          </li>
        ))}
      </ul>
      <div class="poffer__cta reveal">
        <CtaPair href={ctaHref} label={ctaLabel} />
      </div>
    </div>
  </section>
)}

{/* Prueba · métricas y testimonio */}
{(showMetrics || showTestimonial) && (
  <section class="pproof" data-section="proof">
    <div class="wrapx">
      {showMetrics && (
        <ul class="pmetrics reveal" role="list">
          {c.proof.metrics.map((m) => (
            <li class="pmetric">
              <span class="pmetric__n">{m.number}</span>
              <span class="pmetric__l">{m.label}</span>
            </li>
          ))}
        </ul>
      )}
      {showTestimonial && (
        <blockquote class="pquote reveal">
          <p class="pquote__text">“{testimonial.quote}”</p>
          {testimonial.author && (
            <footer class="pquote__author">
              {testimonial.author}{testimonial.context && <span> · {testimonial.context}</span>}
            </footer>
          )}
        </blockquote>
      )}
    </div>
  </section>
)}

{/* Preguntas */}
{showFaqs && (
  <section class="pfaqs" data-section="faqs">
    <div class="wrapx">
      {faqs.map((f) => (
        <details class="pfaq reveal">
          <summary class="pfaq__q">{f.q}</summary>
          <p class="pfaq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

{/* Ubicación */}
{showLocation && (
  <section class="ploc" data-section="location">
    <div class="wrapx ploc__inner reveal">
      {pro.address && <p class="ploc__address">{pro.address}</p>}
      {mapsQuery && (
        <a
          class="ploc__link"
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`}
          target="_blank"
          rel="noopener"
        >Cómo llegar →</a>
      )}
    </div>
  </section>
)}

{/* Cierre · el par de botones otra vez, grande */}
<section class="pclose" data-section="closing">
  <div class="pclose__inner reveal">
    {c.closing.headline && <p class="pclose__head">{c.closing.headline}</p>}
    <CtaPair href={ctaHref} label={closingLabel} size="lg" />
  </div>
</section>

{/* El CTA nunca desaparece */}
<a class="pfloat" href={ctaHref} aria-label={ctaLabel}>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="28" height="28">
    <path d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.11 3.22 5.1 4.51.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z" />
    <path d="M12 2a10 10 0 0 0-8.65 15.02L2.05 21.6a.5.5 0 0 0 .62.61l4.68-1.27A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-2.77.75.74-2.7-.2-.31A8.2 8.2 0 1 1 12 20.2Z" />
  </svg>
</a>

<style>
  .wrapx { max-width: 1000px; margin: 0 auto; padding-inline: 20px; }
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 14px;
  }
  .eyebrow--center { text-align: center; }

  /* ---------- Hero ---------- */
  .phero {
    position: relative; min-height: 100svh;
    display: grid; align-items: end; overflow: hidden;
  }
  .phero__bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 30%;
  }
  .phero__bg--empty { background: var(--paper-alt); }
  .phero__veil {
    position: absolute; inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,.82) 0%, rgba(0,0,0,.55) 40%,
      rgba(0,0,0,.12) 72%, rgba(0,0,0,.2) 100%
    );
  }
  .phero__inner {
    position: relative; width: 100%; max-width: 760px; margin: 0 auto;
    padding: 0 24px clamp(44px, 8vh, 80px); text-align: center;
    animation: phero-in .7s cubic-bezier(.2,0,0,1) both;
  }
  @keyframes phero-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .phero__logo {
    max-height: 44px; width: auto; margin: 0 auto 20px; display: block;
    object-fit: contain; background: rgba(255,255,255,.92);
    border-radius: 6px; padding: 6px 10px;
  }
  .phero__name {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: clamp(30px, 5.6vw, 46px); line-height: 1.06;
    letter-spacing: -.02em; color: #fff; text-wrap: balance;
  }
  .phero__line {
    margin-top: 10px; font-size: clamp(14px, 2vw, 17px);
    color: rgba(255,255,255,.82);
    font-family: var(--mono); letter-spacing: .04em;
  }
  .phero__headline {
    margin-top: 20px; color: #fff; text-wrap: balance;
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: clamp(19px, 3vw, 26px); line-height: 1.25; letter-spacing: -.01em;
  }
  .phero__sub {
    margin-top: 12px; font-size: clamp(15px, 2vw, 17px);
    color: rgba(255,255,255,.86); max-width: 46ch; margin-inline: auto;
    text-wrap: balance;
  }
  .phero__cta { margin-top: 28px; }

  /* ---------- Calificación ---------- */
  .pqual { padding: clamp(40px, 5.5vw, 66px) 0; }
  .pqual__grid { display: grid; gap: 32px; }
  @media (min-width: 720px) { .pqual__grid { grid-template-columns: 1fr 1fr; gap: 48px; } }
  .pqual__col { display: grid; gap: 12px; }
  .pqual__col li {
    position: relative; padding-left: 26px; line-height: 1.5;
  }
  .pqual__col li::before {
    position: absolute; left: 0; top: 0;
    font-family: var(--mono); font-weight: 700;
  }
  .pqual__col--yes li::before { content: '✓'; color: var(--accent); }
  .pqual__col--no li::before { content: '×'; color: var(--ink-soft); }
  .pqual__col--no li { color: var(--ink-soft); }

  /* ---------- Antes / después ---------- */
  .pcases {
    padding: clamp(52px, 8vw, 92px) 0;
    border-top: 1px solid var(--line); background: var(--paper-alt);
  }
  /* Dos casos apilados y grandes: la prueba pega más a tamaño completo que
     partida en dos columnas pequeñas. */
  .pcases__grid {
    display: grid; gap: clamp(30px, 5vw, 52px);
    max-width: 760px; margin: 0 auto;
  }
  .pcase__pair {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3px;
    border-radius: 10px; overflow: hidden; background: var(--line);
  }
  .pcase__side { position: relative; margin: 0; }
  .pcase__side img {
    display: block; width: 100%; aspect-ratio: 4 / 5;
    object-fit: cover; background: var(--paper);
  }
  /* En móvil cada mitad del par mide media pantalla: sin más alto, la prueba
     se ve en miniatura justo donde más tiene que pegar. */
  @media (max-width: 560px) {
    .pcase__side img { aspect-ratio: 3 / 5.4; }
  }
  .pcase__tag {
    position: absolute; left: 10px; bottom: 10px;
    font-family: var(--mono); font-size: 11px; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    padding: 5px 9px; border-radius: 4px;
    background: rgba(0,0,0,.62); color: #fff;
  }
  .pcase__tag--after { background: var(--accent); color: var(--accent-ink); }
  .pcase__label {
    margin-top: 12px; text-align: center; font-size: 14px; color: var(--ink-soft);
  }

  /* ---------- Banda de acción ---------- */
  .pband {
    border-top: 1px solid var(--line);
    padding: clamp(40px, 6vw, 66px) 20px;
  }
  .pband__inner {
    max-width: 620px; margin: 0 auto; text-align: center;
    display: grid; gap: 20px; justify-items: center;
  }
  .pband__text {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: clamp(20px, 3.2vw, 27px); letter-spacing: -.02em;
    text-wrap: balance;
  }

  /* ---------- Confianza ---------- */
  .ptrust { border-block: 1px solid var(--line); }
  .ptrust__line {
    max-width: 900px; margin: 0 auto; padding: clamp(20px, 3vw, 30px) 20px;
    text-align: center; text-wrap: balance;
    font-size: clamp(15px, 2vw, 18px); font-weight: 500;
  }

  /* ---------- Historia ---------- */
  .pstory { padding: clamp(40px, 5.5vw, 66px) 0; }
  .pstory__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 800px) {
    .pstory__grid { grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: 48px; }
  }
  .pstory__photo img {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: 10px; background: var(--paper-alt); display: block;
  }
  .pstory__text { display: grid; gap: 16px; line-height: 1.62; }
  .pstory__wall { font-weight: 600; }
  .pstory__result {
    padding-left: 16px; border-left: 2px solid var(--accent);
    color: var(--ink); font-weight: 500;
  }

  /* ---------- Servicios ---------- */
  .pservices { padding: clamp(40px, 6vw, 68px) 20px; border-top: 1px solid var(--line); }
  .pservices__grid {
    max-width: 900px; margin: 0 auto; display: grid;
    grid-template-columns: repeat(2, 1fr); gap: clamp(24px, 4vw, 40px) 16px;
  }
  @media (min-width: 720px) { .pservices__grid { grid-template-columns: repeat(4, 1fr); } }
  .pservice {
    display: flex; flex-direction: column; align-items: center;
    gap: 12px; text-align: center;
  }
  .pservice__label { font-size: 15px; font-weight: 600; text-wrap: balance; }

  /* ---------- Qué incluye ---------- */
  .poffer {
    padding: clamp(40px, 5.5vw, 66px) 0;
    border-top: 1px solid var(--line); background: var(--paper-alt);
  }
  .poffer__title {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: clamp(23px, 3.6vw, 31px); letter-spacing: -.02em;
    text-align: center; margin-bottom: 28px; text-wrap: balance;
  }
  .poffer__list { display: grid; gap: 12px; max-width: 720px; margin: 0 auto; }
  .poffer__item {
    background: var(--paper); border: 1px solid var(--line);
    border-radius: 8px; padding: 16px 18px;
  }
  .poffer__item-title { font-weight: 600; }
  .poffer__item-desc { margin-top: 5px; color: var(--ink-soft); font-size: 15px; line-height: 1.55; }
  .poffer__cta { margin-top: 28px; }

  /* ---------- Prueba ---------- */
  .pproof { padding: clamp(40px, 5.5vw, 66px) 0; }
  .pmetrics {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 24px; margin-bottom: 44px;
  }
  .pmetric { text-align: center; display: grid; gap: 6px; }
  .pmetric__n {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: clamp(28px, 4.4vw, 39px); letter-spacing: -.02em; color: var(--accent);
  }
  .pmetric__l {
    font-family: var(--mono); font-size: 11px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  .pquote { max-width: 660px; margin: 0 auto; text-align: center; }
  .pquote__text {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: clamp(20px, 3vw, 27px); line-height: 1.36;
    letter-spacing: -.01em; text-wrap: balance;
  }
  .pquote__author {
    margin-top: 16px; font-family: var(--mono); font-size: 12px;
    letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft);
  }

  /* ---------- Preguntas ---------- */
  .pfaqs {
    padding: clamp(44px, 6vw, 72px) 0; border-top: 1px solid var(--line);
  }
  .pfaqs .wrapx { max-width: 760px; }
  .pfaq { border-bottom: 1px solid var(--line); }
  .pfaq__q {
    cursor: pointer; padding: 17px 0; font-weight: 600;
    list-style: none; display: flex; justify-content: space-between; gap: 16px;
  }
  .pfaq__q::-webkit-details-marker { display: none; }
  .pfaq__q::after { content: '+'; color: var(--accent); font-family: var(--mono); }
  .pfaq[open] .pfaq__q::after { content: '−'; }
  .pfaq__a { padding-bottom: 18px; color: var(--ink-soft); line-height: 1.62; }

  /* ---------- Ubicación ---------- */
  .ploc { border-top: 1px solid var(--line); padding: clamp(30px, 4vw, 46px) 0; }
  .ploc__inner { text-align: center; }
  .ploc__address { font-size: 16px; color: var(--ink-soft); text-wrap: balance; }
  .ploc__link {
    display: inline-block; margin-top: 10px; font-weight: 600;
    color: var(--accent); border-bottom: 1px solid currentColor;
  }

  /* ---------- Cierre ---------- */
  .pclose {
    border-top: 1px solid var(--line); background: var(--paper-alt);
    padding: clamp(64px, 10vw, 108px) 20px calc(clamp(64px, 10vw, 108px) + 40px);
  }
  .pclose__inner { max-width: 620px; margin: 0 auto; text-align: center; }
  .pclose__head {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: clamp(23px, 3.8vw, 33px); line-height: 1.2;
    letter-spacing: -.02em; margin-bottom: 26px; text-wrap: balance;
  }

  /* ---------- Flotante ---------- */
  .pfloat {
    position: fixed; right: 18px; bottom: 84px; z-index: 70;
    width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center;
    background: #25D366; color: #fff;
    box-shadow: 0 6px 20px rgba(0,0,0,.22);
    transition: transform .18s cubic-bezier(.2,0,0,1);
  }
  .pfloat:hover { transform: scale(1.06); }
  @media (min-width: 720px) { .pfloat { right: 24px; bottom: 92px; } }
  @media (prefers-reduced-motion: reduce) {
    .phero__inner { animation: none; }
    .pfloat { transition: none; }
  }
</style>
