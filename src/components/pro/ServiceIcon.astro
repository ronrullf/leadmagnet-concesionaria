---
/**
 * Iconos de línea para el bloque de servicios. Trazo, no relleno: pesan poco
 * visualmente y no compiten con las fotos, que son la prueba.
 */
interface Props {
  name: string;
}

const { name } = Astro.props;

const PATHS: Record<string, string> = {
  // Diente
  diente: 'M8.5 3C6 3 4 5 4 7.8c0 2 .5 3.2 1 5.2.4 1.6.6 3.4.8 5 .1 1.2.7 2 1.6 2 1 0 1.4-.9 1.7-2.3l.5-2.4c.2-.9.6-1.3 1.4-1.3s1.2.4 1.4 1.3l.5 2.4c.3 1.4.7 2.3 1.7 2.3.9 0 1.5-.8 1.6-2 .2-1.6.4-3.4.8-5 .5-2 1-3.2 1-5.2C20 5 18 3 15.5 3c-1.4 0-2.4.5-3.5.5S9.9 3 8.5 3Z',
  // Brillo / destello
  brillo: 'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3ZM18.5 15l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z',
  // Sonrisa
  sonrisa: 'M4 11a8 8 0 0 0 16 0M4 11c1.5-1 3.4-1.5 8-1.5s6.5.5 8 1.5M8.5 6.5h.01M15.5 6.5h.01',
  // Alineador / ortodoncia
  alineador: 'M3 9.5c0-1.4 1.1-2.5 2.5-2.5h13c1.4 0 2.5 1.1 2.5 2.5v1c0 3.6-4 6.5-9 6.5s-9-2.9-9-6.5v-1ZM7 8v4M12 8v5M17 8v4M3.5 11h17',
  // Jeringa / aplicación
  jeringa: 'M19 3l2 2M17.5 4.5l2 2M15 7l2 2-8.5 8.5-3.2.7.7-3.2L15 7ZM11 11l2 2',
  // Láser
  laser: 'M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8M12 9.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z',
  // Gota / limpieza
  gota: 'M12 3s6 6.4 6 10.4A6 6 0 0 1 6 13.4C6 9.4 12 3 12 3Z',
  corazon: 'M12 20s-7-4.4-7-9.3A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.7c0 4.9-7 9.3-7 9.3Z',
  estrella: 'M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z',
  escudo: 'M12 3l7.5 3v5.3c0 4.4-3.1 8.4-7.5 9.7-4.4-1.3-7.5-5.3-7.5-9.7V6L12 3ZM9 12l2 2 4-4',
};

const d = PATHS[name] ?? PATHS.estrella;
// El diente y la gota se leen mejor rellenos; el resto es trazo puro.
const filled = name === 'diente' || name === 'gota';
---

<svg
  class="svc-icon"
  viewBox="0 0 24 24"
  width="34"
  height="34"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={filled ? 0 : 1.6}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>

<style>
  .svc-icon { color: var(--accent); flex-shrink: 0; }
</style>
